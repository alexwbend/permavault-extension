{
  "name": "Permavault Archive: Save Web Pages",
  "description": "Save web pages before they change. Pay once to keep the page and its capture record on permanent storage.",
  "version": "$VERSION",
  "permissions": [
    "debugger",
    "contextMenus",
    "tabs",
    "activeTab",
    "storage",
    "unlimitedStorage",
    "webRequest"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "icons": {
    "16": "$ICON16",
    "32": "$ICON32",
    "48": "$ICON48",
    "128": "$ICON"
  },
  "action": {
    "default_icon": {
      "16": "$ICON16",
      "32": "$ICON32"
    },
    "default_title": "Permavault",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdf/*"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "manifest_version": 3
}
