{
  "name": "Permavault",
  "description": "Record pages from your browser, keep a local archive, and choose public permanent storage with a verifiable capture record.",
  "version": "$VERSION",
  "permissions": [
    "debugger",
    "contextMenus",
    "tabs",
    "activeTab",
    "storage",
    "unlimitedStorage",
    "webRequest"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "icons": {
    "32": "$ICON",
    "128": "$ICON"
  },
  "action": {
    "default_icon": {
      "32": "$ICON"
    },
    "default_title": "Permavault",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdf/*"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "manifest_version": 3
}
